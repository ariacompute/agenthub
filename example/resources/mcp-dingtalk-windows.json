{
  "id": "example-mcp-dingtalk-windows",
  "kind": "mcp",
  "namespace": "example-windows",
  "name": "dingtalk",
  "display_name": "DingTalk MCP (Windows)",
  "description": "Official dingtalk-mcp from the DingTalk Open Platform. On Windows npx must be wrapped in cmd /c (explicitly required by the official MCP README).",
  "endpoint": "stdio://dingtalk",
  "transport": "stdio",
  "version": "1.0.0",
  "repository": "https://open.dingtalk.com/document/ai-dev/advanced-configuration",
  "tags": ["mcp"],
  "capabilities": ["tools/list", "tools/call"],
  "metadata": {
    "install": "No installation needed (npx fetches on demand)",
    "env_hint": "DINGTALK_Client_ID, DINGTALK_Client_Secret, ACTIVE_PROFILES (e.g. dingtalk-contacts,dingtalk-calendar)",
    "docs": "https://open.dingtalk.com/document/aipass/install-and-use-the-dingtalk-calendar-mcp"
  },
  "kind_config": {
    "mcp": {
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "dingtalk-mcp@latest"],
      "tool_allowlist": ["get_contacts", "send_robot_message", "create_calendar_event", "create_todo"]
    }
  }
}
