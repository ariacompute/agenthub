{
  "id": "example-mcp-filesystem-windows",
  "kind": "mcp",
  "namespace": "example-windows",
  "name": "filesystem",
  "display_name": "MCP Filesystem (Windows)",
  "description": "Official Model Context Protocol reference server. On Windows npx must be wrapped in cmd /c (explicitly required by the official README), otherwise the MCP client cannot spawn the subprocess.",
  "endpoint": "stdio://filesystem",
  "transport": "stdio",
  "version": "1.0.0",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "tags": ["mcp"],
  "capabilities": ["tools/list", "tools/call"],
  "metadata": {
    "install": "No installation needed (npx fetches on demand)",
    "path_hint": "C:\\Users\\<user>\\docs (replace <user> with your own username)",
    "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem"
  },
  "kind_config": {
    "mcp": {
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\<user>\\docs"],
      "tool_allowlist": ["read_file", "write_file", "list_directory", "search_files"]
    }
  }
}
