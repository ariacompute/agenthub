{
  "id": "example-agent-google-adk-windows",
  "kind": "agent",
  "namespace": "example-windows",
  "name": "google-adk",
  "display_name": "Google ADK（Windows）",
  "description": "Google Agent Development Kit，用官方 to_a2a(root_agent, port=8001) 包成 A2A server。Windows 用 .venv\\Scripts\\activate 激活虚拟环境；uvicorn reloader 若报 _make_subprocess_transport NotImplementedError，加 --no-reload。",
  "endpoint": "http://localhost:8001",
  "version": "1.0.0",
  "repository": "https://github.com/google/adk-python",
  "tags": ["agent"],
  "capabilities": ["run", "run_sse"],
  "auth_schemes": ["bearer"],
  "metadata": {
    "install": "python -m venv .venv && .venv\\Scripts\\activate && pip install \"google-adk[a2a]\"",
    "start": "uvicorn a2a_agent:a2a_app --host localhost --port 8001",
    "port": "8001",
    "docs": "https://adk.dev/a2a/quickstart-exposing/"
  },
  "kind_config": {
    "agent": {
      "card_url": "http://localhost:8001/.well-known/agent-card.json",
      "protocol_version": "a2a/1.0",
      "capabilities": ["streaming"],
      "skills": ["run"],
      "auth_scheme": "bearer"
    }
  }
}
