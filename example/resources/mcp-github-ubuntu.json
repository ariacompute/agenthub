{
  "id": "example-mcp-github-ubuntu",
  "kind": "mcp",
  "namespace": "example-ubuntu",
  "name": "github",
  "display_name": "GitHub MCP Server (Ubuntu, Docker stdio)",
  "description": "Local Docker form of GitHub's official MCP server: docker run -i --rm starts the stdio server and the token is passed through with -e.",
  "endpoint": "stdio://github",
  "transport": "stdio",
  "version": "1.0.0",
  "repository": "https://github.com/github/github-mcp-server",
  "tags": ["mcp"],
  "capabilities": ["tools/list", "tools/call"],
  "metadata": {
    "install": "docker pull ghcr.io/github/github-mcp-server",
    "env_hint": "GITHUB_PERSONAL_ACCESS_TOKEN (environment variable on the server process; do not put it in this JSON)",
    "docs": "https://github.com/github/github-mcp-server"
  },
  "kind_config": {
    "mcp": {
      "transport": "stdio",
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server"],
      "tool_allowlist": ["get_issue", "create_issue", "list_pull_requests", "search_code"]
    }
  }
}
