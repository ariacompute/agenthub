{
  "id": "example-skill-anthropics-pdf-ubuntu",
  "kind": "skill",
  "namespace": "example-ubuntu",
  "name": "pdf",
  "display_name": "Anthropic official pdf skill (Ubuntu)",
  "description": "The pdf skill from the anthropics/skills repository: a skill is a directory containing SKILL.md. Clone the repository to /home/<user>/skills; the skill lives at skills/pdf/ beneath it, so the endpoint must include that directory level.",
  "endpoint": "file:///home/<user>/skills/skills/pdf",
  "version": "1.0.0",
  "repository": "https://github.com/anthropics/skills",
  "tags": ["skill"],
  "capabilities": ["extract_text", "fill_form"],
  "metadata": {
    "install": "git clone https://github.com/anthropics/skills /home/<user>/skills",
    "path_hint": "/home/<user>/skills/skills/pdf/SKILL.md (replace <user> with your own username)",
    "docs": "https://github.com/anthropics/skills"
  },
  "kind_config": {
    "skill": {
      "version": "1.0.0",
      "repository": "https://github.com/anthropics/skills",
      "package": "skills/pdf",
      "triggers": ["pdf", "form filling"],
      "steps": ["read SKILL.md", "extract_text", "fill_form"],
      "tools": ["extract_text", "fill_form"],
      "docs": "SKILL.md"
    }
  }
}
