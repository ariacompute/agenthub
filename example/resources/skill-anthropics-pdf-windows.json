{
  "id": "example-skill-anthropics-pdf-windows",
  "kind": "skill",
  "namespace": "example-windows",
  "name": "pdf",
  "display_name": "Anthropic official pdf skill (Windows)",
  "description": "The pdf skill from the anthropics/skills repository: a skill is a directory containing SKILL.md. On Windows the endpoint uses drive-letter form file:///C:/...; the skill lives at skills/pdf/ inside the repository.",
  "endpoint": "file:///C:/Users/<user>/skills/skills/pdf",
  "version": "1.0.0",
  "repository": "https://github.com/anthropics/skills",
  "tags": ["skill"],
  "capabilities": ["extract_text", "fill_form"],
  "metadata": {
    "install": "git clone https://github.com/anthropics/skills C:\\Users\\<user>\\skills",
    "path_hint": "C:\\Users\\<user>\\skills\\skills\\pdf\\SKILL.md (replace <user> with your own username)",
    "docs": "https://github.com/anthropics/skills"
  },
  "kind_config": {
    "skill": {
      "version": "1.0.0",
      "repository": "https://github.com/anthropics/skills",
      "package": "skills/pdf",
      "triggers": ["pdf", "form filling"],
      "steps": ["read SKILL.md", "extract_text", "fill_form"],
      "tools": ["extract_text", "fill_form"],
      "docs": "SKILL.md"
    }
  }
}
