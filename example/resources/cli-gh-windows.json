{
  "id": "example-cli-gh-windows",
  "kind": "cli",
  "namespace": "example-windows",
  "name": "gh",
  "display_name": "GitHub CLI (Windows)",
  "description": "GitHub CLI (cli/cli, MIT). Install with winget on Windows; the real path is C:\\Program Files\\GitHub CLI\\gh.exe. If command is set to that absolute path, AGENTHUB_CLI_ALLOWLIST must contain the exact same whole string (EqualFold whole-string match).",
  "version": "1.0.0",
  "repository": "https://github.com/cli/cli",
  "tags": ["cli"],
  "capabilities": ["status", "log"],
  "metadata": {
    "command": "gh",
    "install": "winget install --id GitHub.cli",
    "path_hint": "C:\\Program Files\\GitHub CLI\\gh.exe",
    "docs": "https://cli.github.com/"
  },
  "kind_config": {
    "cli": {
      "command": "gh",
      "allowlist": ["repo", "issue", "pr", "auth", "api"],
      "timeout_ms": 15000,
      "max_output_bytes": 65536,
      "work_dir": "C:\\Users\\<user>"
    }
  }
}
