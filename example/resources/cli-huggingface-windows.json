{
  "id": "example-cli-huggingface-windows",
  "kind": "cli",
  "namespace": "example-windows",
  "name": "hf",
  "display_name": "HuggingFace CLI (Windows)",
  "description": "huggingface_hub's bundled CLI; the current command name is hf. On Windows the console script lands in Scripts\\hf.exe; if command is set to an absolute path, AGENTHUB_CLI_ALLOWLIST must contain the exact same whole string.",
  "version": "1.0.0",
  "repository": "https://github.com/huggingface/huggingface_hub",
  "tags": ["cli"],
  "capabilities": ["auth", "download", "upload"],
  "metadata": {
    "command": "hf",
    "install": "python -m venv .venv && .venv\\Scripts\\activate && pip install -U \"huggingface_hub[cli]\"",
    "path_hint": "%APPDATA%\\Python\\Python<ver>\\Scripts\\hf.exe or .venv\\Scripts\\hf.exe",
    "env_hint": "HF_TOKEN (environment variable on the server process)",
    "docs": "https://huggingface.co/docs/huggingface_hub/guides/cli"
  },
  "kind_config": {
    "cli": {
      "command": "hf",
      "allowlist": ["download", "upload", "repo", "auth", "cache", "version"],
      "timeout_ms": 15000,
      "max_output_bytes": 65536,
      "work_dir": "C:\\Users\\<user>"
    }
  }
}
