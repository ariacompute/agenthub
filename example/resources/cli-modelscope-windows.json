{
  "id": "example-cli-modelscope-windows",
  "kind": "cli",
  "namespace": "example-windows",
  "name": "modelscope",
  "display_name": "ModelScope CLI (Windows)",
  "description": "ModelScope CLI. On Windows the console script lands in Scripts\\modelscope.exe; if command is set to an absolute path, AGENTHUB_CLI_ALLOWLIST must contain the exact same whole string.",
  "version": "1.0.0",
  "repository": "https://github.com/modelscope/modelscope",
  "tags": ["cli"],
  "capabilities": ["download", "upload", "server"],
  "metadata": {
    "command": "modelscope",
    "install": "python -m venv .venv && .venv\\Scripts\\activate && pip install modelscope",
    "path_hint": "%APPDATA%\\Python\\Python<ver>\\Scripts\\modelscope.exe or .venv\\Scripts\\modelscope.exe",
    "env_hint": "MODELSCOPE_API_TOKEN (environment variable on the server process)",
    "docs": "https://www.modelscope.cn/docs/sdk/cli"
  },
  "kind_config": {
    "cli": {
      "command": "modelscope",
      "allowlist": ["download", "upload", "login", "create", "server"],
      "timeout_ms": 15000,
      "max_output_bytes": 65536,
      "work_dir": "C:\\Users\\<user>"
    }
  }
}
