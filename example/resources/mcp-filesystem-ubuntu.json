{
  "id": "example-mcp-filesystem-ubuntu",
  "kind": "mcp",
  "namespace": "example-ubuntu",
  "name": "filesystem",
  "display_name": "MCP Filesystem (Ubuntu)",
  "description": "Official Model Context Protocol reference server: exposes a local directory as a stdio MCP server. Runs directly with npx; no Docker required.",
  "endpoint": "stdio://filesystem",
  "transport": "stdio",
  "version": "1.0.0",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "tags": ["mcp"],
  "capabilities": ["tools/list", "tools/call"],
  "metadata": {
    "install": "No installation needed (npx fetches on demand)",
    "path_hint": "/home/<user>/docs (replace <user> with your own username)",
    "docs": "https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem"
  },
  "kind_config": {
    "mcp": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/<user>/docs"],
      "tool_allowlist": ["read_file", "write_file", "list_directory", "search_files"]
    }
  }
}
