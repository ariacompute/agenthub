{
  "id": "example-mcp-google-drive-windows",
  "kind": "mcp",
  "namespace": "example-windows",
  "name": "google-drive",
  "display_name": "Google Drive MCP（Windows）",
  "description": "workspace-mcp 限定 --tools drive。Windows 命令与 Ubuntu 完全相同，差异只在 OAuth 凭据与 token 缓存路径（%USERPROFILE%\\.config\\...）。",
  "endpoint": "stdio://gdrive",
  "transport": "stdio",
  "version": "1.0.0",
  "repository": "https://github.com/endrec/google_workspace_mcp",
  "tags": ["mcp"],
  "capabilities": ["tools/list", "tools/call"],
  "metadata": {
    "install": "winget install astral-sh.uv；uvx workspace-mcp --help",
    "env_hint": "GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET（凭据与 token 缓存落在 %USERPROFILE%\\.config\\ 下）",
    "docs": "https://workspacemcp.com/quick-start"
  },
  "kind_config": {
    "mcp": {
      "transport": "stdio",
      "command": "uvx",
      "args": ["workspace-mcp", "--tool-tier", "core", "--tools", "drive"],
      "tool_allowlist": ["search_drive_files", "get_drive_file_content", "create_drive_file"]
    }
  }
}
