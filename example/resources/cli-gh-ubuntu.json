{
  "id": "example-cli-gh-ubuntu",
  "kind": "cli",
  "namespace": "example-ubuntu",
  "name": "gh",
  "display_name": "GitHub CLI（Ubuntu）",
  "description": "GitHub CLI（cli/cli，MIT）。CLI 适配器运行期只读 metadata.command；真正放行靠服务端 AGENTHUB_CLI_ALLOWLIST（整串 EqualFold 匹配），gh 不在默认值里，需显式加入。CLI 资源没有 endpoint，会被判 degraded，故用 metadata.mock_health 钉住显示值。",
  "version": "1.0.0",
  "repository": "https://github.com/cli/cli",
  "tags": ["cli"],
  "capabilities": ["status", "log"],
  "health": "healthy",
  "metadata": {
    "command": "gh",
    "mock_health": "healthy",
    "install": "sudo apt install gh（官方 apt 源）",
    "path_hint": "/usr/bin/gh",
    "docs": "https://cli.github.com/"
  },
  "kind_config": {
    "cli": {
      "command": "gh",
      "allowlist": ["repo", "issue", "pr", "auth", "api"],
      "timeout_ms": 15000,
      "max_output_bytes": 65536
    }
  }
}
