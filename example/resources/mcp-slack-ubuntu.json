{
  "id": "example-mcp-slack-ubuntu",
  "kind": "mcp",
  "namespace": "example-ubuntu",
  "name": "slack",
  "display_name": "Slack MCP（Ubuntu）",
  "description": "Anthropic 官方 npm 包 @modelcontextprotocol/server-slack（MIT）：列频道、发消息、读历史。需要 Slack bot token 与 team id。",
  "endpoint": "stdio://slack",
  "transport": "stdio",
  "version": "1.0.0",
  "repository": "https://github.com/modelcontextprotocol/servers",
  "tags": ["mcp"],
  "capabilities": ["tools/list", "tools/call"],
  "health": "healthy",
  "metadata": {
    "install": "无需安装（npx 现取现用）",
    "env_hint": "SLACK_BOT_TOKEN, SLACK_TEAM_ID（服务端进程环境变量，不要写进 JSON）",
    "docs": "https://www.npmjs.com/package/@modelcontextprotocol/server-slack"
  },
  "kind_config": {
    "mcp": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "tool_allowlist": ["slack_list_channels", "slack_post_message", "slack_reply_to_thread"]
    }
  }
}
