{
  "id": "example-skill-skillssh-find-skills-ubuntu",
  "kind": "skill",
  "namespace": "example-ubuntu",
  "name": "find-skills",
  "display_name": "skills.sh: find-skills (Ubuntu)",
  "description": "skills.sh is an open Agent Skills directory maintained by Vercel Labs (source: vercel-labs/skills). npx skills add <owner/repo> installs a skill into the project-root .agents/skills/<name>/ directory, which most agents read. find-skills is the most-installed skill in the directory and is itself the meta-skill for discovering other skills.",
  "source_id": "skills.sh",
  "endpoint": "file:///home/<user>/<project>/.agents/skills/find-skills",
  "version": "1.0.0",
  "repository": "https://github.com/vercel-labs/skills",
  "tags": ["skill"],
  "capabilities": ["find_skills", "add_skill"],
  "metadata": {
    "install": "npx skills add vercel-labs/skills",
    "discover": "npx skills find",
    "path_hint": "/home/<user>/<project>/.agents/skills/find-skills/SKILL.md",
    "docs": "https://www.skills.sh"
  },
  "kind_config": {
    "skill": {
      "version": "1.0.0",
      "repository": "https://github.com/vercel-labs/skills",
      "package": "vercel-labs/skills",
      "triggers": ["find a skill", "install a skill"],
      "steps": ["npx skills find", "npx skills add <owner/repo>"],
      "tools": ["find_skills", "add_skill"],
      "docs": "SKILL.md"
    }
  }
}
