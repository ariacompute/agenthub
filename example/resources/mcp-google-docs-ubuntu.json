{
  "id": "example-mcp-google-docs-ubuntu",
  "kind": "mcp",
  "namespace": "example-ubuntu",
  "name": "google-docs",
  "display_name": "Google Docs MCP（Ubuntu）",
  "description": "workspace-mcp 限定 --tools docs。与 Drive / Gmail 三例共用同一个 server，只是工具范围不同，便于按最小权限注册。",
  "endpoint": "stdio://gdocs",
  "transport": "stdio",
  "version": "1.0.0",
  "repository": "https://github.com/endrec/google_workspace_mcp",
  "tags": ["mcp"],
  "capabilities": ["tools/list", "tools/call"],
  "health": "healthy",
  "metadata": {
    "install": "uvx workspace-mcp --help",
    "env_hint": "GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET",
    "docs": "https://workspacemcp.com/quick-start"
  },
  "kind_config": {
    "mcp": {
      "transport": "stdio",
      "command": "uvx",
      "args": ["workspace-mcp", "--tool-tier", "core", "--tools", "docs"],
      "tool_allowlist": ["search_docs", "get_doc_content", "create_doc"]
    }
  }
}
