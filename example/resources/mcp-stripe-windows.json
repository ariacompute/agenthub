{
  "id": "example-mcp-stripe-windows",
  "kind": "mcp",
  "namespace": "example-windows",
  "name": "stripe",
  "display_name": "Stripe MCP（Windows，本地 npx）",
  "description": "Stripe 官方 @stripe/mcp。Windows 上 npx 必须包一层 cmd /c；密钥走服务端进程环境 STRIPE_SECRET_KEY。",
  "endpoint": "stdio://stripe",
  "transport": "stdio",
  "version": "1.0.0",
  "repository": "https://github.com/stripe/ai",
  "tags": ["mcp"],
  "capabilities": ["tools/list", "tools/call"],
  "health": "healthy",
  "metadata": {
    "install": "无需安装（npx 现取现用）",
    "env_hint": "STRIPE_SECRET_KEY（服务端进程环境变量；也可写成 args --api-key=…，但那样密钥会进库）",
    "docs": "https://docs.stripe.com/mcp"
  },
  "kind_config": {
    "mcp": {
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@stripe/mcp", "--tools=all"],
      "tool_allowlist": ["create_customer", "list_customers", "create_payment_link", "list_payment_intents"]
    }
  }
}
