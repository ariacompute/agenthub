# agenthub — A2A interconnection platform (sample environment)

# HTTP listener.
AGENTHUB_HTTP_PORT=3500
AGENTHUB_ENV=dev

# Static assets produced by `make web-build` (the Vue3 console).
AGENTHUB_STATIC_DIR=./backend/static

# Identity and sessions. There is no shared admin token any more: /api/* is
# reachable with a session obtained from /api/auth/login (email + password or
# OAuth), and identities live in the users table.
#
# The bootstrap administrator is upserted on every boot and becomes the owner
# (it holds every permission). AGENTHUB_ENV=prod refuses to start without it.
# Leave both empty and the first registered account becomes the owner instead.
AGENTHUB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AGENTHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
AGENTHUB_BOOTSTRAP_ADMIN_NAME=Administrator
AGENTHUB_SESSION_TTL=12h
# Set to true behind HTTPS; a plain-http dev box cannot log in with it on.
AGENTHUB_COOKIE_SECURE=false
# How the instance is reached from the browser: used to build the OAuth
# callback URL. Empty falls back to the request host.
AGENTHUB_PUBLIC_BASE_URL=

# Client tooling: scripts that talk to the API as an already signed-in user.
# scripts/test-api.sh and example/load.sh both accept AGENTHUB_SESSION_TOKEN
# instead of logging in, sending it as the X-AgentHub-Session header.
#
# The server reads that header (internal/auth/auth.go) and never this variable,
# so this block is configuration for the scripts, not for the instance — no
# deployment needs it, and nothing here reaches the server process.
# AGENTHUB_SESSION_TOKEN=

# OAuth (optional, real authorization code + PKCE). A provider without a client
# id is simply not offered on the login screen.
AGENTHUB_OAUTH_ENABLED=false
AGENTHUB_OAUTH_GOOGLE_CLIENT_ID=
AGENTHUB_OAUTH_GOOGLE_CLIENT_SECRET=
AGENTHUB_OAUTH_GITHUB_CLIENT_ID=
AGENTHUB_OAUTH_GITHUB_CLIENT_SECRET=
AGENTHUB_OAUTH_WECHAT_APP_ID=
AGENTHUB_OAUTH_WECHAT_APP_SECRET=
# Generic OIDC: needs the issuer URL and a client; discovery reads
# {issuer}/.well-known/openid-configuration.
AGENTHUB_OAUTH_OIDC_CLIENT_ID=
AGENTHUB_OAUTH_OIDC_CLIENT_SECRET=
AGENTHUB_OAUTH_OIDC_ISSUER=

# PostgreSQL connection. Mandatory: agenthub refuses to start without it
# (resources, tasks, artifacts, spans, events and push records all live here).
# This value is resolved INSIDE the compose network and injected into the
# agenthub container, so the host must be `postgres`: `localhost` there is the
# container itself. `make run` sets its own inline localhost DSN instead.
# Host port 5434 avoids postgres (5432) and bankmind (5433).
DATABASE_URL=postgres://agenthub:agenthub@postgres:5434/agenthub

# Demo resources: when true, the five demo-* resources are inserted at startup
# (idempotent, ON CONFLICT DO NOTHING) so the README walkthrough and
# scripts/test-api.sh have something to talk to. Default false — an instance
# starts with only the resources you register. Never enable in production
# (config.Validate refuses AGENTHUB_ENV=prod with this on).
AGENTHUB_SEED_DEMO=false

# Example catalogue (example/). Opt-in and OFF by default, for the same reason as
# the demo seeds: an instance starts with only the resources you register.
# ./example/load.sh refuses to run until this is switched on, so a stray
# `cp .env.example .env` can never fill a real instance with sample data.
AGENTHUB_EXAMPLE_ENABLED=false

# Where the loader looks for agenthub. Empty falls back to
# http://127.0.0.1:$AGENTHUB_HTTP_PORT.
# AGENTHUB_EXAMPLE_BASE_URL=

# An account with resources:write. Empty falls back to the bootstrap
# administrator above.
# AGENTHUB_EXAMPLE_EMAIL=
# AGENTHUB_EXAMPLE_PASSWORD=

# Injected into model-gateway.json's kind_config.model.model_id, and used by
# example/deploy-agent.sh as the default --model-id. Use a model id your gateway
# actually serves; the loader exits when it is missing.
AGENTHUB_EXAMPLE_MODEL_ID=ariacompute/ariamodel

# Gateway credentials. load.sh never reads this one: the Aria key must not travel
# through this repo or the database. model-gateway.json only stores the *name*
# AGENTHUB_EXAMPLE_API_KEY (kind_config.model.api_key_env), and each reader takes
# the value from its own environment — the agenthub server process, and
# example/deploy-agent.sh, which also falls back to this file:
#
#   export AGENTHUB_EXAMPLE_API_KEY=sk-...
#   # then start the server, e.g. docker compose up
#
# Uncomment it here and both the server and the deploy script pick it up, and a
# plain `./example/deploy-agent.sh google-adk start` brings up the gateway agent.
# AGENTHUB_EXAMPLE_API_KEY=

# A2A: accept the v0.1 method aliases (tasks/send, tasks/sendSubscribe) in addition to v0.2 names.
AGENTHUB_A2A_LEGACY_METHODS=true

# Adapter limits (mock adapters apply the same limits as the real ones will).
AGENTHUB_MAX_PARALLEL=8
AGENTHUB_CLI_TIMEOUT=15s
AGENTHUB_CLI_ALLOWLIST=git,ls,cat,echo,date,aria-memo
AGENTHUB_MAX_OUTPUT_BYTES=65536
# Bounds one Agent Card fetch plus one message/send when an agent entry publishes
# a card_url. Without a card an agent never leaves the process, so this only
# limits real A2A calls. Keep it generous — a remote agent may itself wait on a
# reasoning gateway (~40s measured); a short budget reports a timeout that is
# indistinguishable from an agent nobody deployed.
AGENTHUB_AGENT_TIMEOUT=120s
AGENTHUB_EVENT_BUFFER=512

# Push notifications for A2A tasks. The mock notifier records every callback in
# push_records (no network I/O); the limit caps the rows kept per task.
AGENTHUB_PUSH_ENABLED=true
AGENTHUB_PUSH_RECORD_LIMIT=100

# Database checkpoints (the console's "Backups" tab). Checkpoints are off until
# a directory is configured: a container with no volume must not quietly fill
# its own writable layer. AGENTHUB_BACKUP_DIR is the only required setting; the
# rest seed the schedule the console edits afterwards (the stored policy always
# wins from then on).
# AGENTHUB_BACKUP_DIR=/var/lib/agenthub/backups
# off | interval | daily | cron — the mode the schedule starts in.
AGENTHUB_BACKUP_MODE=off
AGENTHUB_BACKUP_INTERVAL=24h
AGENTHUB_BACKUP_DAILY_TIME=03:00
AGENTHUB_BACKUP_TIMEZONE=UTC
# Five fields: minute hour day-of-month month day-of-week.
# AGENTHUB_BACKUP_CRON=0 3 * * *
# Retention: keep the newest N checkpoints and delete anything older than the
# age limit. The newest checkpoint is never swept automatically.
AGENTHUB_BACKUP_KEEP_LAST=7
AGENTHUB_BACKUP_MAX_AGE_DAYS=30

# Model router. "mock" keeps the deterministic offline provider (the default).
# "openai_compatible" lets a kind=model entry point at any OpenAI-compatible
# gateway (LiteLLM, OpenRouter, self-hosted) through its own kind_config; per
# entry configuration always wins over this global default. An entry that omits
# kind_config.model.provider_mode inherits this setting, both when it is
# registered (a gateway instance therefore requires endpoint and model_id) and
# when it is invoked. A value outside the vocabulary degrades to mock.
AGENTHUB_MODEL_ROUTER_MODE=openai_compatible

# Upstream registry synchronisation. Off until enabled: a deployment must opt in
# to outbound traffic. The interval must be positive once sync is enabled.
AGENTHUB_REGISTRY_SYNC_ENABLED=false
AGENTHUB_REGISTRY_SYNC_INTERVAL=1h
# true keeps every source on the offline deterministic fixture client, so a
# source never reaches the network even when one is configured with a URL.
AGENTHUB_REGISTRY_SYNC_FIXTURE=true

# Shared files (the workbench's "Shared files" screen). OFF by default: an
# upgraded instance must not begin accepting uploads until an operator picks a
# backend. With off, every /api/files* route answers 503 files_disabled.
# off | local | s3 — any other value fails config.Validate() at startup.
AGENTHUB_FILES_STORE=off
# Per-file cap, enforced while the bytes stream to a temporary file. Minimum
# 1 MiB; the default is 32 MiB (33554432 bytes).
AGENTHUB_FILES_MAX_BYTES=33554432
# local: a writable directory, created 0700 with objects 0600. Required as soon
# as the store is local; a container needs a persistent volume mounted here.
# AGENTHUB_FILES_DIR=/var/lib/agenthub/files

# s3: an S3-compatible store (RustFS / MinIO / AWS), http or https endpoint.
# Only read when the store is s3; endpoint and bucket are required then, and an
# unset value fails startup.
# AGENTHUB_FILES_S3_ENDPOINT=https://s3.example.com
# AGENTHUB_FILES_S3_BUCKET=agenthub-files
# Defaults: us-east-1 and path-style true. Keep path-style true for RustFS/MinIO
# unless wildcard DNS for bucket.host.example is actually configured.
# AGENTHUB_FILES_S3_REGION=us-east-1
# AGENTHUB_FILES_S3_PATH_STYLE=true
# These two name the environment variables that hold the credentials; the keys
# themselves are never inlined here. Export them in the server process before
# switching the store to s3 (config.Validate() checks that they resolve):
#   export AGENTHUB_FILES_S3_ACCESS_KEY=...
#   export AGENTHUB_FILES_S3_SECRET_KEY=...
# Defaults name AGENTHUB_FILES_S3_ACCESS_KEY / AGENTHUB_FILES_S3_SECRET_KEY;
# set these only when your secret manager uses different variable names.
# AGENTHUB_FILES_S3_ACCESS_KEY_ENV=AGENTHUB_FILES_S3_ACCESS_KEY
# AGENTHUB_FILES_S3_SECRET_KEY_ENV=AGENTHUB_FILES_S3_SECRET_KEY
# Switching backends later does not migrate bytes already stored: each row
# remembers the backend that wrote it.
