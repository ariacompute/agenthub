# agenthub — A2A interconnection platform (sample environment)

# HTTP listener. 3500 avoids the ports taken by bankmind (8080), cockpit store (3400) and postgres (5432/5433).
AGENTHUB_HTTP_PORT=3500
AGENTHUB_ENV=dev

# Static assets produced by `make web-build` (the Vue3 console).
AGENTHUB_STATIC_DIR=./backend/static

# Control plane auth. When empty, /api/* is reachable only if AGENTHUB_AUTH_OPEN_MODE=true.
AGENTHUB_ADMIN_TOKEN=
AGENTHUB_AUTH_OPEN_MODE=true

# Optional JSON snapshot of the registry (loaded at boot, saved on shutdown). Empty disables persistence.
AGENTHUB_DATA_FILE=

# A2A: accept the v0.1 method aliases (tasks/send, tasks/sendSubscribe) in addition to v0.2 names.
AGENTHUB_A2A_LEGACY_METHODS=true

# Adapter limits (mock adapters apply the same limits as the real ones will).
AGENTHUB_MAX_PARALLEL=8
AGENTHUB_CLI_TIMEOUT=15s
AGENTHUB_CLI_ALLOWLIST=git,ls,cat,echo,date,aria-memo
AGENTHUB_MAX_OUTPUT_BYTES=65536
AGENTHUB_EVENT_BUFFER=512

# Push notifications for A2A tasks (mock notifier; recorded in memory only).
AGENTHUB_PUSH_ENABLED=true
