# agenthub — A2A interconnection platform (Security-hardened example)

# HTTP listener.
AGENTHUB_HTTP_PORT=3500
AGENTHUB_ENV=prod

# Static assets produced by `make web-build` (the Vue3 console).
AGENTHUB_STATIC_DIR=./backend/static

# Identity and sessions. /api/* is reachable only with a session obtained from
# /api/auth/login (email + password or OAuth); identities live in the users
# table. The bootstrap administrator is upserted on every boot and becomes the
# owner (holds every permission). AGENTHUB_ENV=prod refuses to start without it.
#
# Replace both placeholders before deploying — use a strong, unique password
# (>= 16 chars, mixed classes) and a real administrator address.
AGENTHUB_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AGENTHUB_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-random-password
AGENTHUB_BOOTSTRAP_ADMIN_NAME=Administrator
# Prefer a shorter session on a hardened box and let idle sessions expire.
AGENTHUB_SESSION_TTL=8h
# Secure cookies are mandatory behind HTTPS. A plain-http box cannot log in with
# this on, so it must only be true when a TLS-terminating proxy is in front.
AGENTHUB_COOKIE_SECURE=true
# Externally visible origin: used to build the OAuth callback URL. Set to the
# real HTTPS hostname; empty falls back to the request host (not safe in prod).
AGENTHUB_PUBLIC_BASE_URL=

# OAuth (optional, real authorization code + PKCE). A provider without a client
# id is simply not offered on the login screen. Keep disabled until you have
# configured a provider below; leaving it off removes the attack surface.
AGENTHUB_OAUTH_ENABLED=false
AGENTHUB_OAUTH_GOOGLE_CLIENT_ID=
AGENTHUB_OAUTH_GOOGLE_CLIENT_SECRET=
AGENTHUB_OAUTH_GITHUB_CLIENT_ID=
AGENTHUB_OAUTH_GITHUB_CLIENT_SECRET=
# Generic OIDC: needs the issuer URL and a client; discovery reads
# {issuer}/.well-known/openid-configuration.
AGENTHUB_OAUTH_OIDC_CLIENT_ID=
AGENTHUB_OAUTH_OIDC_CLIENT_SECRET=
AGENTHUB_OAUTH_OIDC_ISSUER=

# PostgreSQL connection. Mandatory. Use the least-privilege `app` role here;
# DDL runs under the separate migrator role below. TLS to the database is
# optional — set sslmode=require|verify-ca|verify-full in the DSN only if your
# Postgres actually serves TLS.
#
# Replace <db-password> with the app role's secret (from your secret manager).
DATABASE_URL=postgres://agenthub:<db-password>@db:5432/agenthub

# Migration role. A higher-privilege DSN used ONLY to run schema migrations; the
# runtime connection above stays the least-privilege app role. Provision both
# with scripts/provision-db-roles.sql (app / migrator / readonly). Omit if you
# run migrations with the same role as the app (not recommended).
AGENTHUB_MIGRATOR_DATABASE_URL=postgres://migrator:<migrator-password>@db:5432/agenthub
# Connection pool sizing (store/db.go). Defaults shown; override per workload.
AGENTHUB_DB_MAX_OPEN_CONNS=25
AGENTHUB_DB_MAX_IDLE_CONNS=10
AGENTHUB_DB_CONN_MAX_LIFETIME=30m

# Static-at-rest encryption. REQUIRED in prod (>= 32 bytes): backs any encrypted
# column and encrypts checkpoint archives (AES-256-GCM) when a backup directory
# is set. Generate with `openssl rand -base64 48` and inject from a secret
# manager — never commit the real value. A missing/short key fails to start in
# prod.
AGENTHUB_ENCRYPTION_KEY=change-me-to-a-32+-byte-random-secret

# Signed A2A push callbacks (SSRF-hardened). When set (>= 16 bytes), outgoing
# push notifications are HMAC-SHA256 signed (timestamp + nonce + body) so the
# receiver can verify authenticity, freshness (+/-5m) and replay; the
# destination is https-only and never resolves to a private/loopback/link-local
# address. Omit only if you do not use A2A push notifications.
AGENTHUB_PUSH_SECRET=change-me-to-a-16+-byte-random-secret

# Demo resources: MUST stay off in production — demo rows would be
# indistinguishable from real ones, and config.Validate refuses prod with this
# on.
AGENTHUB_SEED_DEMO=false

# Example catalogue (example/). OFF in any real deployment: a hardened instance
# starts with only the resources you register. ./example/load.sh refuses to run
# until this is switched on.
AGENTHUB_EXAMPLE_ENABLED=false

# Where the loader looks for agenthub. Empty falls back to
# http://127.0.0.1:$AGENTHUB_HTTP_PORT.
# AGENTHUB_EXAMPLE_BASE_URL=

# An account with resources:write. Empty falls back to the bootstrap
# administrator above.
# AGENTHUB_EXAMPLE_EMAIL=
# AGENTHUB_EXAMPLE_PASSWORD=

# Injected into model-gateway.json's kind_config.model.model_id. The gateway key
# itself NEVER travels through this repo or the database (only the env var name
# does). Keep the key in the server process environment only:
#   export AGENTHUB_EXAMPLE_API_KEY=sk-...
# (omitted here so no secret is ever committed)
AGENTHUB_EXAMPLE_MODEL_ID=ariacompute/ariamodel

# A2A: accept the v0.1 method aliases (tasks/send, tasks/sendSubscribe) in
# addition to v0.2 names. Disable on a hardened instance to shrink the contract
# surface unless legacy clients require it.
AGENTHUB_A2A_LEGACY_METHODS=false

# Adapter limits (mock adapters apply the same limits as the real ones will).
AGENTHUB_MAX_PARALLEL=8
AGENTHUB_CLI_TIMEOUT=15s
# Keep the allowlist tight: only the commands agents are allowed to invoke.
AGENTHUB_CLI_ALLOWLIST=git,ls,cat,echo,date,aria-memo
AGENTHUB_MAX_OUTPUT_BYTES=65536
# Bounds one Agent Card fetch plus one message/send when an agent entry
# publishes a card_url; only limits real A2A calls. Keep it generous.
AGENTHUB_AGENT_TIMEOUT=120s
AGENTHUB_EVENT_BUFFER=512

# Push notifications for A2A tasks. When AGENTHUB_PUSH_SECRET is set the outbound
# call is signed and SSRF-guarded; the record limit caps the rows kept per task.
AGENTHUB_PUSH_ENABLED=true
AGENTHUB_PUSH_RECORD_LIMIT=100

# Database checkpoints (the console's "Backups" tab). Off until a directory is
# configured. With AGENTHUB_ENCRYPTION_KEY set, archives are encrypted at rest
# (AES-256-GCM) as <file>.tar.gz.enc with a sha256 manifest — plaintext never
# touches disk. Validate recoverability with scripts/backup-restore-drill.sh.
# AGENTHUB_BACKUP_DIR=/var/lib/agenthub/backups
# off | interval | daily | cron — the mode the schedule starts in.
AGENTHUB_BACKUP_MODE=off
AGENTHUB_BACKUP_INTERVAL=24h
AGENTHUB_BACKUP_DAILY_TIME=03:00
AGENTHUB_BACKUP_TIMEZONE=UTC
# Five fields: minute hour day-of-month month day-of-week.
# AGENTHUB_BACKUP_CRON=0 3 * * *
# Retention: keep the newest N checkpoints and delete anything older than the
# age limit. The newest checkpoint is never swept automatically.
AGENTHUB_BACKUP_KEEP_LAST=7
AGENTHUB_BACKUP_MAX_AGE_DAYS=30

# Model router. "mock" keeps the deterministic offline provider (no credentials
# needed). "openai_compatible" lets a kind=model entry point at any
# OpenAI-compatible gateway; per-entry configuration always wins.
AGENTHUB_MODEL_ROUTER_MODE=openai_compatible

# Upstream registry synchronisation. OFF by default in a hardened deployment: an
# instance must not reach out to an upstream registry until an operator has
# configured one and decided how often to pull. When you enable it, the sync
# client uses an SSRF-guarded SafeClient (https-only, no private/loopback
# targets, no redirect following). Keep AGENTHUB_REGISTRY_SYNC_FIXTURE=true to
# force every source onto the offline fixture (air-gap) even if a URL is set.
AGENTHUB_REGISTRY_SYNC_ENABLED=false
AGENTHUB_REGISTRY_SYNC_INTERVAL=1h
AGENTHUB_REGISTRY_SYNC_FIXTURE=true
